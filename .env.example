##############################################################################
# Copy to `.env.local` and fill in the blanks. `.env.local` is gitignored.
##############################################################################

# --- Database (matches docker-compose.yml) -------------------------------
DATABASE_URL="postgresql://choosy:choosy@localhost:5434/choosy_development?schema=public"

# --- Gravity OAuth (next-auth) ---------------------------------------------
# See ticket #27 — choosy needs its own Gravity ClientApplication, with
# http://localhost:3000/api/auth/callback/artsy registered as an allowed
# redirect URI (a prod/staging ClientApplication will reject it).
GRAVITY_URL="https://api.artsy.net"
NEXT_PUBLIC_GRAVITY_URL="https://api.artsy.net"
CLIENT_APPLICATION_ID=""
CLIENT_APPLICATION_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # generate with: openssl rand -base64 32

# --- Unleash (feature flags) ------------------------------------------------
# See ticket #28 — flag + keys need to be created in the Unleash web UI.
UNLEASH_URL="https://app.unleash-hosted.com/api"
UNLEASH_SERVER_KEY=""
NEXT_PUBLIC_UNLEASH_URL="https://app.unleash-hosted.com/api/frontend"
NEXT_PUBLIC_UNLEASH_FRONTEND_KEY=""
